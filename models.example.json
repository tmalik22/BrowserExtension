      "model": "deepseek-v4.1-flash",
      "baseURL": "https://ark.cn-beijing.volces.com/api/coding/v3",
      "apiKeyEnv": "ARK_API_KEY",
      "vision": true,
      "toolSet": "full",
      "timeoutMs": 300000,
      "replayReasoning": true,
      "keepImages": 3
    },
    {
