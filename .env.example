# Copy to .env and fill in the keys you have. Never commit .env.

# --- Model provider keys (referenced by "apiKeyEnv" in models.json) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NANOGPT_API_KEY=
# Volcano Engine Ark coding plan key
ARK_API_KEY=
# NVIDIA NIM key (build.nvidia.com, starts with nvapi-)
NVIDIA_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
CUSTOM_API_KEY=

# --- Agent server ---
# AGENT_HOST=127.0.0.1
# AGENT_PORT=7878
# Pairing token for the extension. If unset, one is generated and stored in data/token.txt.
# AGENT_TOKEN=
# Profile to use by default (an id from models.json)
# AGENT_DEFAULT_PROFILE=ollama
# Restrict which extension IDs may connect (comma-separated; empty = any extension)
# AGENT_EXTENSION_IDS=
# Extra operator instructions appended to the system prompt
# AGENT_EXTRA_INSTRUCTIONS=
# Set to 0 to stop saving session transcripts and screenshots in data/sessions (also turns off chat history)
# AGENT_TRANSCRIPTS=1
# Set to 0 to stop fetching live model lists from providers you have keys for (only models.json is used)
# AGENT_MODEL_LISTS=1
# Set to 0 to stop auto-detecting Ollama / LM Studio models
# AGENT_DETECT_LOCAL=1
# Set to 0 to turn off the GPU monitor (nvidia-smi)
# BA_GPU=1
# Alternative models file / data dir
# AGENT_MODELS_FILE=
# AGENT_DATA_DIR=
